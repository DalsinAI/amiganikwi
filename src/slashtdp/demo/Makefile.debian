OUTPUT = demo
CC = g++
LD = g++
CFLAGS = -Wall -g3
CPPFLAGS = 
INCLUDES = -I../include
LDFLAGS = -O 
LIBS = -lSDL -L.. -lslashtdp

CC = g++
AR = ar

OBJECTS = main.o
HEADERS =

$(OUTPUT): $(OBJECTS)
	rm -f $(OUTPUT)
	$(LD) $(OBJECTS) -o $(OUTPUT) $(LDFLAGS) $(LIBS)

.SUFFIXES : .c .cc .cpp .C .S .o

# object from C
.c.o :  $< $(HEADERS)
	$(CC) $(INCLUDES) $(CFLAGS) -c $< -o $@

# object from C++ (.cc, .cpp, .C files)
.cc.o .cpp.o .C.o : $< $(HEADERS)
	$(CC) $(INCLUDES) $(CFLAGS) $(CPPFLAGS) -c $< -o $@

# object from asm
.S.o :
	$(CC) $(ASMFLAGS) -c $< -o $@

clean:
	rm -f $(OBJECTS)

distclean: clean
	rm -f $(OUTPUT)

.PHONY: clean distclean
